# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Model endpoint (OpenAI-compatible). Defaults target DeepSeek.
API_KEY=
API_BASE=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_PROVIDER=OpenAI
# Optional: a different model for the review panel.
TYCHE_REVIEW_MODEL_NAME=
# Optional: a different model for openjiuwen's experiment agents (design, coding, reflection).
TYCHE_EXPERIMENT_MODEL_NAME=
# Optional: raise Semantic Scholar / OpenAlex rate limits (both throttle anonymous clients).
S2_API_KEY=
OPENALEX_API_KEY=
# Optional: identifies polite API clients to OpenAlex/Crossref/arXiv.
TYCHE_CONTACT_EMAIL=
# Optional: where runs, caches, and cross-run memory live (default ./workspace).
TYCHE_HOME=
